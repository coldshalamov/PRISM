  "components": {
    "schemas": {
      "AuditRequest": {
        "properties": {
          "columns": {
            "items": {
              "$ref": "#/components/schemas/ColumnSpec"
            },
            "type": "array",
            "maxItems": 80,
            "minItems": 1,
            "title": "Columns"
          },
          "threat": {
            "$ref": "#/components/schemas/ThreatModel"
          },
          "queries": {
            "items": {
              "$ref": "#/components/schemas/Query"
            },
            "type": "array",
            "maxItems": 30,
            "title": "Queries"
          },
          "release_type": {
            "type": "string",
            "enum": [
              "transformed",
              "synthetic",
              "unknown"
            ],
            "title": "Release Type",
            "default": "unknown"
          },
          "confirm_same_schema_semantics": {
            "type": "boolean",
            "title": "Confirm Same Schema Semantics",
            "default": false
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "columns",
          "threat"
        ],
        "title": "AuditRequest"
      },
      "ColumnSpec": {
        "properties": {
          "name": {
            "type": "string",
            "maxLength": 160,
            "minLength": 1,
            "title": "Name"
          },
          "role": {
            "type": "string",
            "enum": [
              "identifier",
              "quasi",
              "sensitive",
              "analytical",
              "ignore"
            ],
            "title": "Role",
            "default": "analytical"
          },
          "kind": {
            "type": "string",
            "enum": [
              "numeric",
              "categorical",
              "date",
              "text"
            ],
            "title": "Kind",
            "default": "categorical"
          },
          "unit": {
            "anyOf": [
              {
                "type": "string",
                "maxLength": 40
              },
              {
                "type": "null"
              }
            ],
            "title": "Unit"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "name"
        ],
        "title": "ColumnSpec"
      },
      "EvaluateRequest": {
        "properties": {
          "recipe": {
            "$ref": "#/components/schemas/Recipe"
          },
          "columns": {
            "items": {
              "$ref": "#/components/schemas/ColumnSpec"
            },
            "type": "array",
            "maxItems": 80,
            "minItems": 1,
            "title": "Columns"
          },
          "threat": {
            "$ref": "#/components/schemas/ThreatModel"
          },
          "queries": {
            "items": {
              "$ref": "#/components/schemas/Query"
            },
            "type": "array",
            "maxItems": 30,
            "title": "Queries"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "recipe",
          "columns",
          "threat"
        ],
        "title": "EvaluateRequest"
      },
      "ExportRequest": {
        "properties": {
          "variant_id": {
            "type": "string",
            "title": "Variant Id"
          },
          "roles_reviewed": {
            "type": "boolean",
            "title": "Roles Reviewed"
          },
          "authorized_to_share": {
            "type": "boolean",
            "title": "Authorized To Share"
          },
          "limitations_acknowledged": {
            "type": "boolean",
            "title": "Limitations Acknowledged"
          },
          "review_note": {
            "type": "string",
            "maxLength": 1000,
            "minLength": 8,
            "title": "Review Note"
          },
          "spreadsheet_safe": {
            "type": "boolean",
            "title": "Spreadsheet Safe",
            "default": true
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "variant_id",
          "roles_reviewed",
          "authorized_to_share",
          "limitations_acknowledged",
          "review_note"
        ],
        "title": "ExportRequest"
      },
      "Filter": {
        "properties": {
          "column": {
            "type": "string",
            "title": "Column"
          },
          "op": {
            "type": "string",
            "enum": [
              "eq",
              "ne",
              "ge",
              "gt",
              "le",
              "lt",
              "in",
              "is_null"
            ],
            "title": "Op",
            "default": "eq"
          },
          "value": {
            "title": "Value"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "column"
        ],
        "title": "Filter"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "Operation": {
        "properties": {
          "method": {
            "type": "string",
            "enum": [
              "drop",
              "mask",
              "pseudonymize",
              "numeric_band",
              "prefix",
              "top_bottom_code",
              "round",
              "rare_category",
              "date_year",
              "date_shift",
              "jitter",
              "shuffle",
              "redact_patterns"
            ],
            "title": "Method"
          },
          "columns": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "maxItems": 80,
            "minItems": 1,
            "title": "Columns"
          },
          "width": {
            "type": "number",
            "maximum": 1000000000.0,
            "exclusiveMinimum": 0.0,
            "title": "Width",
            "default": 5
          },
          "prefix_length": {
            "type": "integer",
            "maximum": 32.0,
            "minimum": 0.0,
            "title": "Prefix Length",
            "default": 3
          },
          "lower": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "title": "Lower"
          },
          "upper": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "title": "Upper"
          },
          "min_count": {
            "type": "integer",
            "maximum": 30000.0,
            "minimum": 2.0,
            "title": "Min Count",
            "default": 5
          },
          "magnitude": {
            "type": "number",
            "maximum": 1000000.0,
            "minimum": 0.0,
            "title": "Magnitude",
            "default": 1
          },
          "fraction": {
            "type": "number",
            "maximum": 1.0,
            "minimum": 0.0,
            "title": "Fraction",
            "default": 1
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "method",
          "columns"
        ],
        "title": "Operation"
      },
      "OptimizeRequest": {
        "properties": {
          "recipe": {
            "$ref": "#/components/schemas/Recipe"
          },
          "columns": {
            "items": {
              "$ref": "#/components/schemas/ColumnSpec"
            },
            "type": "array",
            "maxItems": 80,
            "minItems": 1,
            "title": "Columns"
          },
          "threat": {
            "$ref": "#/components/schemas/ThreatModel"
          },
          "queries": {
            "items": {
              "$ref": "#/components/schemas/Query"
            },
            "type": "array",
            "maxItems": 30,
            "title": "Queries"
          },
          "age_column": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Age Column",
            "default": "age"
          },
          "zip_column": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Zip Column",
            "default": "zip"
          },
          "weight_column": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Weight Column",
            "default": "weight_kg"
          },
          "max_candidates": {
            "type": "integer",
            "maximum": 18.0,
            "minimum": 2.0,
            "title": "Max Candidates",
            "default": 12
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "recipe",
          "columns",
          "threat"
        ],
        "title": "OptimizeRequest"
      },
      "Query": {
        "properties": {
          "name": {
            "type": "string",
            "maxLength": 120,
            "minLength": 1,
            "title": "Name"
          },
          "statistic": {
            "type": "string",
            "enum": [
              "count",
              "mean",
              "rate",
              "correlation"
            ],
            "title": "Statistic"
          },
          "column": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Column"
          },
          "second_column": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Second Column"
          },
          "positive_value": {
            "title": "Positive Value",
            "default": 1
          },
          "filters": {
            "items": {
              "$ref": "#/components/schemas/Filter"
            },
            "type": "array",
            "maxItems": 12,
            "title": "Filters"
          },
          "tolerance": {
            "type": "number",
            "exclusiveMinimum": 0.0,
            "title": "Tolerance",
            "default": 0.05
          },
          "weight": {
            "type": "number",
            "maximum": 100.0,
            "exclusiveMinimum": 0.0,
            "title": "Weight",
            "default": 1
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "name",
          "statistic"
        ],
        "title": "Query"
      },
      "Recipe": {
        "properties": {
          "label": {
            "type": "string",
            "maxLength": 100,
            "title": "Label",
            "default": "Candidate"
          },
          "operations": {
            "items": {
              "$ref": "#/components/schemas/Operation"
            },
            "type": "array",
            "maxItems": 40,
            "title": "Operations"
          },
          "suppress_below_k": {
            "anyOf": [
              {
                "type": "integer",
                "maximum": 5000.0,
                "minimum": 2.0
              },
              {
                "type": "null"
              }
            ],
            "title": "Suppress Below K"
          },
          "max_suppression_fraction": {
            "type": "number",
            "maximum": 1.0,
            "minimum": 0.0,
            "title": "Max Suppression Fraction",
            "default": 0.2
          },
          "shuffle_rows": {
            "type": "boolean",
            "title": "Shuffle Rows",
            "default": true
          }
        },
        "additionalProperties": false,
        "type": "object",
        "title": "Recipe"
      },
      "ThreatModel": {
        "properties": {
          "known_columns": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "maxItems": 10,
            "title": "Known Columns"
          },
          "sensitive_columns": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "maxItems": 10,
            "title": "Sensitive Columns"
          },
          "membership_known": {
            "type": "boolean",
            "title": "Membership Known",
            "default": true
          },
          "one_row_per_person_confirmed": {
            "type": "boolean",
            "title": "One Row Per Person Confirmed",
            "default": false
          },
          "entity_column": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Entity Column"
          },
          "context": {
            "type": "string",
            "enum": [
              "internal",
              "collaboration",
              "public"
            ],
            "title": "Context",
            "default": "collaboration"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "title": "ThreatModel"
      },
      "ValidationError": {
        "properties": {
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "type": "array",
            "title": "Location"
          },
          "msg": {
            "type": "string",
            "title": "Message"
          },
          "type": {
            "type": "string",
            "title": "Error Type"
          },
          "input": {
            "title": "Input"
          },
          "ctx": {
            "type": "object",
            "title": "Context"
          }
        },
        "type": "object",
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError"
      }
    }
  }
}
